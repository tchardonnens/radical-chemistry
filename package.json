{
  "name": "radical-chemistry",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/package.js",
    "native": "rustc -C opt-level=3 -C target-cpu=native backend/sim.rs -o backend/sim",
    "wasm": "rustc --target wasm32-unknown-unknown --crate-type=cdylib -C opt-level=3 -C panic=abort -C lto=fat -C codegen-units=1 -C strip=symbols backend/sim.rs -o backend/sim.wasm"
  },
  "dependencies": {
    "@preact/signals": "^2.11.2",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
